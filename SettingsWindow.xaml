<Window x:Class="Clim8.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="clim8 settings"
        Width="294"
        Height="250"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="SettingsCardBrush" Color="#FF111A2B"/>
    <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF5F7FB"/>
    <SolidColorBrush x:Key="SettingsMutedBrush" Color="#FF8994A8"/>
    <SolidColorBrush x:Key="SettingsDividerBrush" Color="#FF263146"/>
    <Style x:Key="SettingsRowStyle" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="7,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="RowSurface"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SettingsDividerBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="#FF34435E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsIconBadgeStyle" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="#FF172236"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource SettingsCardBrush}"
          BorderBrush="{DynamicResource SettingsDividerBrush}"
          BorderThickness="1"
          CornerRadius="21"
          Padding="12"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="31"/>
        <RowDefinition Height="42"/>
        <RowDefinition Height="42"/>
        <RowDefinition Height="42"/>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="3,0,2,4">
        <TextBlock Text="Settings"
                   Foreground="{StaticResource SettingsTextBrush}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <Button x:Name="CloseButton"
                Content="×"
                Click="CloseButton_Click"
                Width="26"
                Height="26"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource SettingsMutedBrush}"
                Background="Transparent"
                BorderThickness="0"
                FontSize="18"
                Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="CloseSurface"
                      Background="{TemplateBinding Background}"
                      CornerRadius="9">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource SettingsDividerBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="CloseSurface" Property="Background" Value="#FF34435E"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>

      <Button x:Name="LocationButton"
              Grid.Row="1"
              Style="{StaticResource SettingsRowStyle}"
              Click="LocationButton_Click"
              Cursor="Hand">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconBadgeStyle}">
            <Image Source="pack://siteoforigin:,,,/assets/icons/settings-location.png"
                   Width="18" Height="18" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Grid.Column="1" Text="Location"
                     Foreground="{StaticResource SettingsTextBrush}"
                     FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="LocationValue" Grid.Column="2" Text="Current location"
                     Foreground="{StaticResource SettingsMutedBrush}"
                     FontSize="10" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="92"/>
        </Grid>
      </Button>

      <Button x:Name="UnitsButton"
              Grid.Row="2"
              Style="{StaticResource SettingsRowStyle}"
              Click="UnitsButton_Click"
              Cursor="Hand">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconBadgeStyle}">
            <Image Source="pack://siteoforigin:,,,/assets/icons/settings-temperature.png"
                   Width="18" Height="18" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Grid.Column="1" Text="Temperature units"
                     Foreground="{StaticResource SettingsTextBrush}"
                     FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="UnitsValue" Grid.Column="2" Text="°C"
                     Foreground="{StaticResource SettingsMutedBrush}"
                     FontSize="10" VerticalAlignment="Center"/>
        </Grid>
      </Button>

      <Grid Grid.Row="3" Margin="7,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource SettingsIconBadgeStyle}">
          <Image Source="pack://siteoforigin:,,,/assets/icons/settings-start-with-windows.png"
                 Width="18" Height="18" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <TextBlock Grid.Column="1" Text="Start with Windows"
                   Foreground="{StaticResource SettingsTextBrush}"
                   FontSize="11" VerticalAlignment="Center"/>
        <CheckBox x:Name="StartupCheckBox"
                  Grid.Column="2"
                  Width="31"
                  Height="18"
                  Checked="StartupCheckBox_Changed"
                  Unchecked="StartupCheckBox_Changed"
                  VerticalAlignment="Center"
                  Margin="3,0,2,0">
          <CheckBox.Template>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <Grid>
                <Border x:Name="Track"
                        Background="#FF34435E"
                        CornerRadius="9"/>
                <Ellipse x:Name="Thumb"
                         Width="12"
                         Height="12"
                         Fill="#FFF5F7FB"
                         HorizontalAlignment="Left"
                         Margin="3,0,0,0"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="#FF6CB6E8"/>
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </CheckBox.Template>
        </CheckBox>
      </Grid>

      <Button x:Name="RefreshButton"
              Grid.Row="4"
              Style="{StaticResource SettingsRowStyle}"
              Click="RefreshButton_Click"
              Cursor="Hand">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource SettingsIconBadgeStyle}">
            <Image Source="pack://siteoforigin:,,,/assets/icons/settings-refresh-weather.png"
                   Width="18" Height="18" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Grid.Column="1" Text="Refresh weather"
                     Foreground="{StaticResource SettingsTextBrush}"
                     FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="›"
                     Foreground="{StaticResource SettingsMutedBrush}"
                     FontSize="17" VerticalAlignment="Center"/>
        </Grid>
      </Button>

      <TextBlock Grid.Row="5"
                 Text="Google Weather · forecast"
                 Foreground="{StaticResource SettingsMutedBrush}"
                 FontSize="9"
                 VerticalAlignment="Bottom"
                 Margin="7,0,0,1"/>
    </Grid>
  </Border>
</Window>

